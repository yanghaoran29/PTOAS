// RUN: ptoas --pto-arch=a5 %s | FileCheck %s

module attributes {"pto.target_arch" = "a5"} {
  func.func @textract_mx_scale_left() {
    %c0 = arith.constant 0 : index
    %src = pto.alloc_tile : !pto.tile_buf<loc=mat, dtype=!pto.f8E8M0, rows=16, cols=32, v_row=16, v_col=32, blayout=row_major, slayout=row_major, fractal=32, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=16, cols=4, v_row=16, v_col=4, blayout=row_major, slayout=row_major, fractal=32, pad=0>
    pto.textract ins(%src, %c0, %c0 : !pto.tile_buf<loc=mat, dtype=!pto.f8E8M0, rows=16, cols=32, v_row=16, v_col=32, blayout=row_major, slayout=row_major, fractal=32, pad=0>, index, index)
                 outs(%dst : !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=16, cols=4, v_row=16, v_col=4, blayout=row_major, slayout=row_major, fractal=32, pad=0>)
    %data = pto.alloc_tile : !pto.tile_buf<loc=left, dtype=f8E4M3FN, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=row_major, fractal=512, pad=0>
    pto.tget_scale_addr ins(%data : !pto.tile_buf<loc=left, dtype=f8E4M3FN, rows=16, cols=128, v_row=16, v_col=128, blayout=row_major, slayout=row_major, fractal=512, pad=0>)
                         outs(%dst : !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=16, cols=4, v_row=16, v_col=4, blayout=row_major, slayout=row_major, fractal=32, pad=0>)
    return
  }

  func.func @textract_mx_scale_right() {
    %c0 = arith.constant 0 : index
    %src = pto.alloc_tile : !pto.tile_buf<loc=mat, dtype=!pto.f8E8M0, rows=32, cols=256, v_row=32, v_col=256, blayout=col_major, slayout=col_major, fractal=32, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=4, cols=256, v_row=4, v_col=256, blayout=col_major, slayout=col_major, fractal=32, pad=0>
    pto.textract ins(%src, %c0, %c0 : !pto.tile_buf<loc=mat, dtype=!pto.f8E8M0, rows=32, cols=256, v_row=32, v_col=256, blayout=col_major, slayout=col_major, fractal=32, pad=0>, index, index)
                 outs(%dst : !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=4, cols=256, v_row=4, v_col=256, blayout=col_major, slayout=col_major, fractal=32, pad=0>)
    %data = pto.alloc_tile : !pto.tile_buf<loc=right, dtype=f8E4M3FN, rows=128, cols=256, v_row=128, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>
    pto.tget_scale_addr ins(%data : !pto.tile_buf<loc=right, dtype=f8E4M3FN, rows=128, cols=256, v_row=128, v_col=256, blayout=row_major, slayout=col_major, fractal=512, pad=0>)
                         outs(%dst : !pto.tile_buf<loc=scaling, dtype=!pto.f8E8M0, rows=4, cols=256, v_row=4, v_col=256, blayout=col_major, slayout=col_major, fractal=32, pad=0>)
    return
  }
}

// CHECK-LABEL: AICORE void textract_mx_scale_left(
// CHECK: Tile<TileType::Mat, float8_e8m0_t, 16, 32
// CHECK: Tile<TileType::ScaleLeft, float8_e8m0_t, 16, 4
// CHECK: GetScaleAddr(
// CHECK: TASSIGN(
// CHECK: TEXTRACT(
// CHECK-LABEL: AICORE void textract_mx_scale_right(
// CHECK: Tile<TileType::Mat, float8_e8m0_t, 32, 256
// CHECK: Tile<TileType::ScaleRight, float8_e8m0_t, 4, 256
// CHECK: GetScaleAddr(
// CHECK: TASSIGN(
// CHECK: TEXTRACT(
